      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "groups": [
        "/pacs-viewer"
      ],
      "realmRoles": [
        "viewer"
      ]
    },
    {
      "username": "gateway_denied_dev",
